# ==============================================================================
# AI Powered Workspace - Production Environment Variables Template
# Copy this file to .env.production on your EC2 instance and fill in real values.
# ==============================================================================

# Node Environment & Server
NODE_ENV=production
PORT=5000
API_PREFIX=/api
LOG_LEVEL=info

# CORS - Set to your Vercel frontend URL once deployed
# Example: https://ai-workspace.vercel.app
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# PostgreSQL Database (Neon / Supabase recommended for Free Tier)
# Must include pgvector extension enabled
# Example: postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/ai_workspace?sslmode=require
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_workspace
DB_POOL_MIN=2
DB_POOL_MAX=10

# ------------------------------------------------------------------------------
# RabbitMQ (CloudAMQP Free Tier recommended, e.g. amqps://user:pass@lemur.rmq.cloudamqp.com/vhost)
# If using the optional EC2 docker rabbitmq service: amqp://guest:guest@rabbitmq:5672/
# ------------------------------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
QUEUE_NAME=document-processing

# ------------------------------------------------------------------------------
# Authentication & Security
# Generate secure 64-char keys (e.g. using: openssl rand -hex 32)
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_long_random_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_long_random_jwt_refresh_secret_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Shared secret between Node.js API and Python AI Service
AI_SERVICE_TOKEN=replace_with_a_long_random_internal_service_token

# ------------------------------------------------------------------------------
# Object Storage (AWS S3)
# ------------------------------------------------------------------------------
S3_REGION=us-east-1
S3_BUCKET_NAME=your-production-bucket-name
S3_ACCESS_KEY_ID=your_aws_access_key_id
S3_SECRET_ACCESS_KEY=your_aws_secret_access_key
# Leave S3_ENDPOINT empty when using real AWS S3 (only used for local MinIO)
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
MAX_FILE_SIZE_BYTES=52428800

# ------------------------------------------------------------------------------
# AI Provider & Models (Google Gemini)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
AI_PROVIDER=ai-service
EMBEDDING_PROVIDER=gemini
EMBEDDING_DIMENSION=768
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_PRIMARY_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3-flash-preview
RAG_SIMILARITY_THRESHOLD=0.45
RAG_TOP_K=5

# ------------------------------------------------------------------------------
# Email Configuration (Nodemailer Gmail SMTP or Resend)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
EMAIL_FROM="AI Workspace <your_email@gmail.com>"
RESEND_API_KEY=

# ------------------------------------------------------------------------------
# Error Monitoring (Optional - Sentry)
# ------------------------------------------------------------------------------
SENTRY_DSN=
