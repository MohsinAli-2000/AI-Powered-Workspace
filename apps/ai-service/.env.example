PORT=8001
HOST=127.0.0.1
ENVIRONMENT=development
LOG_LEVEL=info

DATABASE_URL=postgresql://postgres:postgresadmin@localhost:5432/ai_workspace

# Local AI / Ollama Configuration (Kept for reference - uncomment to use local models):
# OLLAMA_BASE_URL=http://localhost:11434
# EMBEDDING_MODEL=nomic-embed-text
# LLM_MODEL=qwen2.5
# AI_PROVIDER=ollama
EMBEDDING_DIMENSION=768
AI_PROVIDER=gemini

RAG_SIMILARITY_THRESHOLD=0.6
RAG_TOP_K=5

SENTRY_DSN=

GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_PRIMARY_MODEL=gemini-3.6-flash
# Set AI_PROVIDER=gemini to use the Gemini API instead of local Ollama

# Shared secret the API sends as X-Internal-Token (generate a long random string; same value in apps/api/.env)
AI_SERVICE_TOKEN=
# Optional: second Gemini model tried when the primary stays overloaded (503/429)
GEMINI_FALLBACK_MODEL=gemini-3-flash-preview

# Gemini Retry & Resilience Configuration
GEMINI_MAX_RETRIES=4
GEMINI_INITIAL_RETRY_DELAY=1.0
GEMINI_MAX_RETRY_DELAY=10.0
GEMINI_TIMEOUT_SECONDS=60.0
