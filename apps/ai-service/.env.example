PORT=8001
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=info

DATABASE_URL=postgresql://postgres:postgresadmin@localhost:5432/ai_workspace

OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
LLM_MODEL=qwen2.5
AI_PROVIDER=ollama

RAG_SIMILARITY_THRESHOLD=0.35
RAG_TOP_K=5

SENTRY_DSN=

GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_LLM_MODEL=gemini-3.8-flash
# Set AI_PROVIDER=gemini to use the Gemini API instead of local Ollama
