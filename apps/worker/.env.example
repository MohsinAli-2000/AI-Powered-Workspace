# Server & Logging
LOG_LEVEL=INFO

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgresadmin@localhost:5432/ai_workspace
DB_POOL_MIN=2
DB_POOL_MAX=10

# S3 / MinIO Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET_NAME=ai-workspace-documents
S3_FORCE_PATH_STYLE=true
MAX_FILE_SIZE_BYTES=52428800

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
QUEUE_NAME=document-processing

# Chunking Defaults
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Embedding Pipeline (Phase 11)
# Local Ollama settings (kept for reference - uncomment to use local models):
# EMBEDDING_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_PROVIDER=gemini
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3
EMBEDDING_TIMEOUT_SECONDS=30.0

# Gemini API Configuration (Default Cloud Provider)
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
