# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/dummy/dummy
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dummy_db
DB_POOL_MIN=22222
DB_POOL_MAX=11111

# Logging
LOG_LEVEL=debug

# Sentry (Optional for local development)
SENTRY_DSN=

# JWT & Authentication
JWT_SECRET=your_jwt_secret_key_must_be_at_least_32_chars_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_must_be_at_least_32_chars_long
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Object Storage (MinIO for development / AWS S3 for production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=ai-workspace-documents
S3_FORCE_PATH_STYLE=true
MAX_FILE_SIZE_BYTES=52428800

