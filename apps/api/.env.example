# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/dummy/dummy
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dummy_db
DB_POOL_MIN=22222
DB_POOL_MAX=11111

# Logging
LOG_LEVEL=debug

# Sentry (Optional for local development)
SENTRY_DSN=
