# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/dummy/dummy
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dummy_db
DB_POOL_MIN=22222
DB_POOL_MAX=11111

# Logging
LOG_LEVEL=debug

# Sentry (Optional for local development)
SENTRY_DSN=

# JWT & Authentication
JWT_SECRET=your_jwt_secret_key_must_be_at_least_32_chars_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_must_be_at_least_32_chars_long
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Object Storage (MinIO for development / AWS S3 for production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=ai-workspace-documents
S3_FORCE_PATH_STYLE=true
MAX_FILE_SIZE_BYTES=52428800

# AI & RAG Configuration (Phase 12)
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=qwen2.5
RAG_SIMILARITY_THRESHOLD=0.45
RAG_TOP_K=5
# AI_PROVIDER=ollama  # direct local Ollama
AI_PROVIDER=ai-service  # routes via apps/ai-service (Gemini)

# Email Configuration (Nodemailer Gmail SMTP or Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
EMAIL_FROM="AI Workspace <your_email@gmail.com>"

# Optional alternative: Resend (requires custom domain to send to any address)
RESEND_API_KEY=

# Shared secret for calls to apps/ai-service (must match its AI_SERVICE_TOKEN)
AI_SERVICE_TOKEN=
